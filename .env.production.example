# =====================================================================
# PRODUCTION ENV TEMPLATE — TIPIGANAN backend
# ---------------------------------------------------------------------
# Copy this to `.env` ON THE SERVER, then fill in every CHANGE_ME value.
# Never commit the filled-in file (.env and .env.production are gitignored).
# After editing, run:  php artisan config:cache && php artisan route:cache
# =====================================================================

APP_NAME=TIPIGANAN
APP_ENV=production
# Generate on the server with: php artisan key:generate
APP_KEY=
# Turning this off is the single most important production setting —
# leaving it true leaks stack traces and internals on every error.
APP_DEBUG=false
# The public URL of the BACKEND/API (https).
APP_URL=https://CHANGE_ME_API_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Reports/timestamps render in this timezone. Asia/Manila for PH-local time.
# IMPORTANT: set this before go-live on a fresh DB — flipping it on a
# populated DB leaves old rows (UTC) 8h off from new ones.
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Quieter than dev — don't write debug-level noise to disk in production.
LOG_LEVEL=warning

# --- Database -------------------------------------------------------
# Create a DEDICATED, limited-privilege MySQL user scoped to this database.
# Do NOT use root, and never leave the password blank in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tipiganan
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Only needed if `mysqldump` isn't on the server's PATH (it usually is).
# Used by `php artisan backup:database`.
# DB_DUMP_BINARY=/usr/bin/mysqldump

# --- Sessions -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over https.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sync = OCR runs inline with uploads. Switch to database/redis + run a
# queue worker only once your host supports a persistent worker (see checklist).
QUEUE_CONNECTION=sync

CACHE_STORE=redis
# Spatie permission cache stays on 'file' (it isn't wrapped by SafeCache, so
# a Redis blip must not 500 every permission-gated route).
PERMISSION_CACHE_STORE=file

# --- Redis ----------------------------------------------------------
# Set a password OR bind Redis to 127.0.0.1 with protected-mode on (ideally both).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_MAX_RETRIES=0

# --- Mail -----------------------------------------------------------
# 'log' is a no-op (writes to the log). Configure a real mailer only if/when
# you add email features — the current design has no self-service email flow.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@CHANGE_ME_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# --- Meilisearch ----------------------------------------------------
# MUST set a master key in production and bind Meilisearch to 127.0.0.1 —
# without a key, anyone who can reach the port can read/alter the whole index
# (titles, abstracts, keywords, full OCR text). Start it with --master-key.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=CHANGE_ME_MEILISEARCH_MASTER_KEY

# --- Sanctum --------------------------------------------------------
# Token auth is stateless (Bearer), so stateful domains can stay empty.
SANCTUM_STATEFUL_DOMAINS=
# 7 days (minutes). Tokens expire and bounce the user to /login.
SANCTUM_TOKEN_EXPIRATION=10080

# Days a superseded thesis PDF stays restorable before auto-purge.
THESIS_OLD_FILE_RETENTION_DAYS=30

# --- CORS -----------------------------------------------------------
# The exact origin(s) your FRONTEND is served from. This is what locks the
# API to your site in production. Comma-separate multiple origins.
FRONTEND_URL=https://CHANGE_ME_FRONTEND_DOMAIN
