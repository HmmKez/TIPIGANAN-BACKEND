APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# PH-local time for reports/timestamps. Keep this in sync across the team —
# without it the app falls back to UTC and hourly reports read 8h off.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# database = zero setup, always works. Switch to redis for faster caching
# on reports/categories, but only after installing a local Redis-compatible
# server (see README.md "Optional: Redis / Memurai") — the app degrades
# gracefully either way, so this is never required.
CACHE_STORE=database
# CACHE_PREFIX=

# Optional — search still works without this via a MySQL fallback.
# See README.md "Optional: Meilisearch" for local setup.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

MEMCACHED_HOST=127.0.0.1

# predis, not phpredis — a pure-PHP client, no compiled extension needed.
# REDIS_MAX_RETRIES=0 matters if CACHE_STORE=redis but no server is running:
# it fails fast instead of paying Predis's multi-second retry/backoff cost
# on every request.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_MAX_RETRIES=0

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Minutes until an issued Sanctum auth token expires. There's no self-service
# password reset or silent token-refresh flow, so an expired token just
# bounces the user to /login — pick a value that won't interrupt a normal
# work session. 10080 = 7 days.
SANCTUM_TOKEN_EXPIRATION=10080

# Days a superseded thesis PDF (from a file replace) stays restorable before
# the auto-purge sweep deletes it for good.
THESIS_OLD_FILE_RETENTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"

# Audit log retention. Only usage-analytics entries (thesis views, searches)
# are pruned after this many days, and only after they are archived to CSV.
# Security/administrative entries (logins, permission grants, uploads, deletions)
# are never pruned automatically. Runs monthly via `php artisan audit:prune`.
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_DISK=local
